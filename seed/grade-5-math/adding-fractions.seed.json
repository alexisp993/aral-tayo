  "lesson": {
    "title": "Adding Fractions",
    "slug": "adding-fractions",
    "version": 1,
    "summary": "Learn to add fractions with like and unlike denominators using visual models, equivalent fractions, and common denominators.",
    "estimated_minutes": 25,
    "gating": {
      "flashcards_available": "immediately",
      "learn_required_for_practice": true,
      "practice_required_for_quiz": true,
      "minimum_practice_completion_percent": 80
    },
    "competencies": [
      {
        "key": "fraction-parts",
        "statement": "Identify the numerator and denominator of a fraction.",
        "weight": 0.1
      },
      {
        "key": "equivalent-fractions",
        "statement": "Recognize and generate simple equivalent fractions.",
        "weight": 0.2
      },
      {
        "key": "add-like-fractions",
        "statement": "Add fractions with the same denominator.",
        "weight": 0.25
      },
      {
        "key": "add-unlike-fractions",
        "statement": "Add fractions with different denominators by using a common denominator.",
        "weight": 0.35
      },
      {
        "key": "fraction-word-problems",
        "statement": "Solve simple real-life problems involving addition of fractions.",
        "weight": 0.1
      }
    ],
    "learn_blocks": [
      {
        "type": "intro",
        "ordinal": 1,
        "title": "What is a fraction?",
        "body": "A fraction shows equal parts of a whole. The numerator tells how many parts we have, while the denominator tells how many equal parts make the whole."
      },
      {
        "type": "worked_example",
        "ordinal": 2,
        "title": "Adding like fractions",
        "body": "When denominators are the same, keep the denominator and add the numerators.",
        "example": {
          "expression": "2/4 + 1/4",
          "steps": [
            "The denominators are both 4.",
            "Add the numerators: 2 + 1 = 3.",
            "Keep the denominator 4."
          ],
          "answer": "3/4"
        }
      },
      {
        "type": "key_takeaway",
        "ordinal": 3,
        "title": "Remember",
        "body": "For like fractions: add the numerators and keep the common denominator."
      },
      {
        "type": "worked_example",
        "ordinal": 4,
        "title": "Adding unlike fractions",
        "body": "When denominators are different, first rewrite the fractions using a common denominator.",
        "example": {
          "expression": "1/2 + 1/4",
          "steps": [
            "A common denominator is 4.",
            "Rewrite 1/2 as 2/4.",
            "Add 2/4 + 1/4 = 3/4."
          ],
          "answer": "3/4"
        }
      },
      {
        "type": "real_life",
        "ordinal": 5,
        "title": "Pizza example",
        "body": "If Alex eats 1/4 of a pizza and later eats another 2/4, he has eaten 3/4 of the pizza in total."
      }
    ],
    "flashcards": [
      {
        "ordinal": 1,
        "front": "Fraction",
        "back": "A number that represents part of a whole or group."
      },
      {
        "ordinal": 2,
        "front": "Numerator",
        "back": "The top number. It tells how many parts are considered."
      },
      {
        "ordinal": 3,
        "front": "Denominator",
        "back": "The bottom number. It tells how many equal parts make the whole."
      },
      {
        "ordinal": 4,
        "front": "Equivalent fractions",
        "back": "Fractions that look different but represent the same value, such as 1/2 and 2/4."
      },
      {
        "ordinal": 5,
        "front": "Common denominator",
        "back": "A denominator shared by fractions so they can be combined or compared."
      },
      {
        "ordinal": 6,
        "front": "Like fractions",
        "back": "Fractions with the same denominator."
      },
      {
        "ordinal": 7,
        "front": "Unlike fractions",
        "back": "Fractions with different denominators."
      },
      {
        "ordinal": 8,
        "front": "1/2 = ?/4",
        "back": "2/4"
      }
    ],
